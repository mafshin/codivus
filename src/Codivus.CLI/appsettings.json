{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Codivus": {
    "ApiUrl": "https://localhost:5001",
    "DataDirectory": "./data",
    "ConfigDirectory": "./config",
    "DefaultLLMProvider": "Ollama",
    "Graph": {
      "JanusGraph": {
        "Host": "localhost",
        "Port": 8182,
        "EnableSsl": false,
        "ConnectionPoolSize": 4
      }
    },
    "LLMProviders": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "codellama:7b",
        "Timeout": 300
      },
      "LMStudio": {
        "BaseUrl": "http://localhost:1234",
        "DefaultModel": "codellama-7b-instruct",
        "Timeout": 300
      }
    },
    "Scanning": {
      "DefaultFilePatterns": [ "*.cs", "*.js", "*.ts", "*.py", "*.java", "*.cpp", "*.h" ],
      "ExcludePatterns": [ "bin/**", "obj/**", "node_modules/**", ".git/**", "*.min.js" ],
      "MaxFileSize": 1048576,
      "EnableParallelProcessing": true,
      "MaxConcurrency": 4
    },
    "Output": {
      "DefaultFormat": "console",
      "SupportedFormats": [ "console", "json", "xml", "csv", "html" ],
      "EnableColors": true,
      "EnableProgress": true
    }
  }
}