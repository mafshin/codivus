{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:5001"
  },
  "Codivus": {
    "ApiUrl": "https://localhost:5001",
    "DataDirectory": "./data",
    "ConfigDirectory": "./config",
    "DefaultLLMProvider": "Ollama",
    "Graph": {
      "Enabled": false,
      "Neo4j": {
        "Uri": "bolt://localhost:7687",
        "Username": "neo4j",
        "Password": "pass12345678",
        "Database": "neo4j",
        "MaxConnectionPoolSize": 50,
        "ConnectionAcquisitionTimeout": "00:01:00",
        "ConnectionTimeout": "00:00:30",
        "EnableEncryption": false,
        "TrustStrategy": "TrustAllCertificates"
      }
    },
    "LLMProviders": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "codellama:7b",
        "Timeout": 300
      },
      "LMStudio": {
        "BaseUrl": "http://localhost:1234",
        "DefaultModel": "codellama-7b-instruct",
        "Timeout": 300
      }
    },
    "Scanning": {
      "DefaultFilePatterns": [ "*.cs", "*.js", "*.ts", "*.py", "*.java", "*.cpp", "*.h" ],
      "ExcludePatterns": [ "bin/**", "obj/**", "node_modules/**", ".git/**", "*.min.js" ],
      "MaxFileSize": 1048576,
      "EnableParallelProcessing": true,
      "MaxConcurrency": 4
    },
    "Output": {
      "DefaultFormat": "console",
      "SupportedFormats": [ "console", "json", "xml", "csv", "html" ],
      "EnableColors": true,
      "EnableProgress": true
    }
  }
}